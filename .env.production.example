# Copy to .env.production (never commit it) and fill every value.
POSTGRES_USER=bentbound
POSTGRES_PASSWORD=          # openssl rand -base64 32
POSTGRES_DB=bentbound
REDIS_PASSWORD=             # openssl rand -hex 24
PUBLIC_WEB_URL=https://bentandbound.com
PUBLIC_API_URL=https://bentandbound.com
SESSION_SECRET=             # openssl rand -hex 32
ENCRYPTION_KEY=             # openssl rand -hex 32  (back it up: needed to decrypt stored courier credentials)
SMTP_URL=
MAIL_FROM="Bent & Bound <no-reply@bentandbound.com>"
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=false

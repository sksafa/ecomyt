# ── Runtime ──────────────────────────────────────────────
NODE_ENV=development
PORT=8080
# Comma separated list of browser origins allowed by CORS
CLIENT_URL=http://localhost:3000
# Public URL of this API (used for webhook URLs and upload links)
API_PUBLIC_URL=http://localhost:8080
LOG_LEVEL=info

# ── Data stores (see /docker-compose.yml) ────────────────
DATABASE_URL=postgresql://bentbound:bentbound_dev_pw@127.0.0.1:5442/bentbound
TEST_DATABASE_URL=postgresql://bentbound:bentbound_dev_pw@127.0.0.1:5442/bentbound_test
REDIS_URL=redis://127.0.0.1:6390

# ── Security ─────────────────────────────────────────────
# 32+ random bytes, e.g. `openssl rand -hex 32`
SESSION_SECRET=change-me
# 64 hex chars (32 bytes) used to encrypt courier/payment credentials and 2FA secrets
ENCRYPTION_KEY=change-me-64-hex-chars
SESSION_TTL_HOURS=12
# true in production (requires HTTPS)
COOKIE_SECURE=false

# ── Bootstrap admin (npm run db:seed) ────────────────────
# Development only. In production create the first admin with this seed and change the password immediately.
SEED_ADMIN_EMAIL=admin@bentandbound.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin User

# ── Demo data ────────────────────────────────────────────
# `npm run db:seed:demo` refuses to run unless this is true and NODE_ENV != production
DEMO_MODE=false

# ── Email (SMTP). Leave empty to log emails instead of sending ──
SMTP_URL=
MAIL_FROM="Bent & Bound <no-reply@bentandbound.com>"

# ── Meta (Facebook) Conversions API ──────────────────────
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# ── WhatsApp Business Cloud API (official; templates must be approved in WhatsApp Manager) ──
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Payments (sandbox credentials; leave empty to disable) ──
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

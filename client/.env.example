# Express API that /api/* and /uploads/* are proxied to (server side only)
API_URL=http://localhost:8080
# Public Meta Pixel id for the storefront (or set it in Admin → Settings → Meta pixel). See docs/meta-tracking.md
NEXT_PUBLIC_META_PIXEL_ID=
# Public site origin used for canonical / OpenGraph URLs (set in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
